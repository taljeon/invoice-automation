{
  "name": "invoice-automation-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:backend",
    "test:run": "vitest run",
    "check": "npm run type-check && npm test && npm run build && python3 scripts/check-public-package.py",
    "test:unit": "vitest run",
    "test:backend": "npm --prefix functions run build && node --test tests/backend*.node.cjs"
  },
  "dependencies": {
    "encoding-japanese": "^2.2.0",
    "firebase": "^12.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
