# Default is the offline synthetic demo. No credentials are required.
VITE_DEMO_MODE=true
# Set false only for a separately configured Firebase project.
# Firebase web configuration is public client metadata, never an AI secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
