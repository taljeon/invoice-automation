{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./lib",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "resolveJsonModule": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext"
  },
  "compileOnSave": true,
  "include": [
    "src",
    "src/types/**/*.d.ts"
  ]
}
