# Cloud calls remain disabled until the operator explicitly enables them.
CLOUD_PROCESSING_ENABLED=false
FUNCTIONS_REGION=asia-northeast1
# Set to the bucket attached to your own Firebase project.
STORAGE_BUCKET=
# Explicit browser origins, comma separated (including your Hosting origin).
ALLOWED_ORIGINS=http://localhost:5173
OPENAI_MODEL=gpt-5
# OPENAI_API_KEY belongs in Firebase Secret Manager, never in a committed env file.
